{
  "name": "decky-trailers",
  "version": "1.0.0",
  "description": "Replaces the hero artwork on a game's library page with its Steam store trailer.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "package": "python scripts/package.py"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "trailer",
    "hero"
  ],
  "author": "LennartDV",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/LennartDV/decky-trailers.git"
  },
  "bugs": {
    "url": "https://github.com/LennartDV/decky-trailers/issues"
  },
  "homepage": "https://github.com/LennartDV/decky-trailers#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.16.5",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  }
}
